# ============================================================
# Beco Platform: environment template
#
# Copy to .env.local and fill in. .env.local is GITIGNORED and
# must never be committed. This file holds NAMES ONLY, no values.
#
# Where each value comes from: docs/ENVIRONMENT.md
# How to set up the accounts:  docs/SETUP.md
# ============================================================

# ---- LOCAL DEVELOPMENT ----
# Run `supabase start`, then `supabase status` prints these three.
# They are the same on every machine, so they are not secrets, but they
# are also not written here so nobody pastes a real key by muscle memory.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- PUBLIC. Shipped to the browser in plain text. ----
# Never put anything here you would not print on a billboard.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_HOST=http://localhost:3000/dev-images
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=254722333730
NEXT_PUBLIC_BUSINESS_PHONE=+254722333730

# ---- SERVER ONLY. Dashboard project only, never the storefront. ----
RESEND_API_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=beco-product-images

# Studio routes only. Brightex's own key. See D40.
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- TOOLING. Local only, never in an app. ----
# Path to the Google service account JSON. The FILE lives outside the repo.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=
DRIVE_ROOT_FOLDER_ID=1jx_FdPwWYRPfIMjnP-5R4xfWGWsEyCG3
