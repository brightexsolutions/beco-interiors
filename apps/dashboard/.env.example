# ============================================================
# DASHBOARD. Public variables plus server only secrets.
#
# Every SERVER ONLY value below is read in server components,
# route handlers and server actions. None reaches the browser.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_IMAGE_HOST=http://localhost:3000/dev-images
NEXT_PUBLIC_WHATSAPP_NUMBER=254722333730
NEXT_PUBLIC_BUSINESS_PHONE=+254722333730

# ---- SERVER ONLY ----
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Sender for transactional email. Must be an address on a domain verified in
# Resend. @beco/documents falls back to a placeholder so the shape is visible.
QUOTE_FROM_EMAIL=Beco Interiors <quotes@beco.co.ke>
# Storefront origin. A catalogue write busts that app's ISR cache here, and
# @beco/documents builds the email header logo's URL from it, since an email
# client can only load a real, publicly reachable image, never a relative
# or a build time local path.
STOREFRONT_URL=http://localhost:3000
# Shared with the storefront `/api/revalidate` route. Not a data secret.
REVALIDATE_SECRET=
# Operational alerts. Failures (an email that did not send, a PDF that did not
# render, a storefront that did not refresh, a website quote that did not
# save) are logged as "ops_alert" and emailed here, throttled. Comma separate
# several addresses. Defaults to info.brightexsolutions@gmail.com.
OPS_ALERT_EMAIL=info.brightexsolutions@gmail.com
# Optional sender for alerts, else QUOTE_FROM_EMAIL.
OPS_ALERT_FROM_EMAIL=
# Shared with the storefront, which relays its own failures to /api/ops-alert.
OPS_ALERT_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=beco-product-images

# Studio routes only. Brightex's key. See D40 and D42.
GEMINI_API_KEY=
GEMINI_MODEL=
