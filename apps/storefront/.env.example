# ============================================================
# STOREFRONT. Public variables, plus one server-only cache token.
#
# This app must NEVER receive the service role key, the Resend key,
# the R2 credentials or the Gemini key. If the storefront is fully
# compromised, the attacker holds the anon key, which every visitor's
# browser already has. That is the entire point of the split.
#
# REVALIDATE_SECRET is the exception: it only lets the dashboard bust
# ISR after a catalogue write. It cannot read or write rows.
#
# CI fails the build if a secret appears here.
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_IMAGE_HOST=http://localhost:3000/dev-images
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=254722333730
NEXT_PUBLIC_BUSINESS_PHONE=+254722333730

# Server only. Shared with the dashboard so a catalogue write can bust ISR.
# Not a data secret: leaking it lets someone force rebuilds, not read rows.
REVALIDATE_SECRET=

# Server only. Operational alerts: this app never holds the Resend key, so a
# failure (a quote request that did not save, an unhandled error) is relayed
# to the dashboard's /api/ops-alert, which emails Brightex. Leaking the
# secret lets someone send Brightex a rate limited, bounded alert, nothing
# more. Must match the dashboard's OPS_ALERT_SECRET.
DASHBOARD_URL=http://localhost:3001
OPS_ALERT_SECRET=
